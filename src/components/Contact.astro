---
import { SITE } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import EmailIcon from './EmailIcon.astro';
import Section from './Section.astro';
---

<Section id="contact" title="Let's Talk" kicker="// get in touch">
  <div
    class="reveal rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900"
  >
    <p class="mb-2 leading-relaxed">
      My current focus is my MSc in Artificial Intelligence at Monash University and
      delivering AI workshops through Icon Learning &amp; Development.
    </p>
    <p class="mb-6 leading-relaxed">
      I'm open to selective collaborations, advisory work and future opportunities where my mix of
      production engineering and teaching can make a meaningful difference. If that sounds like
      what you're building, my inbox is open. 😉
    </p>
    <p class="mb-3 text-xs font-medium text-slate-500 dark:text-slate-400">
      Based in {SITE.location} · {SITE.workAuthorization} · Open to regional opportunities
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href={`mailto:${SITE.email}`}
        aria-label={`Email me at ${SITE.email}`}
        title={`Email ${SITE.email}`}
        class="inline-flex size-11 items-center justify-center rounded-lg bg-accent-600 text-white transition-colors hover:bg-accent-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
      >
        <EmailIcon />
      </a>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="View my LinkedIn profile"
        title="LinkedIn"
        class="brand-hover inline-flex size-11 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition-colors hover:border-[#0A66C2] hover:text-[#0A66C2] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0A66C2] dark:border-slate-700 dark:text-slate-300 dark:hover:border-[#0A66C2] dark:hover:text-[#0A66C2]"
      >
        <BrandIcon monogram="in" brand="#0A66C2" size="size-5" />
      </a>
      <a
        href={SITE.whatsapp}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="Contact me on WhatsApp at +65 9242 0327"
        title="WhatsApp"
        class="brand-hover inline-flex size-11 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition-colors hover:border-[#25D366] hover:text-[#128C7E] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366] dark:border-slate-700 dark:text-slate-300 dark:hover:border-[#25D366] dark:hover:text-[#25D366]"
      >
        <BrandIcon slug="whatsapp" size="size-5" />
      </a>
      <a
        href={SITE.github}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="View my GitHub profile"
        title="GitHub"
        class="brand-hover inline-flex size-11 items-center justify-center rounded-lg border border-slate-300 text-slate-700 transition-colors hover:border-slate-500 hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-slate-500 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500 dark:hover:text-white"
      >
        <BrandIcon slug="github" size="size-5" />
      </a>
    </div>
  </div>
</Section>

<footer class="border-t border-slate-200 py-8 text-center text-sm text-slate-500 dark:border-slate-800 dark:text-slate-500">
  <p class="font-mono">
    © {new Date().getFullYear()} Christopher Wong Teng Foong · <span class="text-accent-600 dark:text-accent-400">cwtf.dev</span>
  </p>
  <p class="mt-1 text-xs">Built with Astro + Tailwind CSS, deployed on Cloudflare Pages.</p>
</footer>
