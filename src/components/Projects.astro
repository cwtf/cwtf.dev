---
import { PROJECTS } from '../data/site';
import BrandIcon from './BrandIcon.astro';
import Section from './Section.astro';
---

<Section id="projects" title="Projects" kicker="// what I've shipped">
  <p class="reveal -mt-4 mb-8 max-w-2xl text-slate-600 dark:text-slate-400">
    Live projects spanning AI tooling, interactive visualizations and device-to-device utilities.
    Working software, not slideware.
  </p>

  <div class="grid items-start gap-6 sm:grid-cols-2">
    {
      PROJECTS.map((p) => (
        <details class="reveal brand-hover group rounded-2xl border border-slate-200 bg-slate-50 transition-colors hover:border-accent-400 open:border-accent-400 dark:border-slate-800 dark:bg-slate-900 dark:hover:border-accent-500 dark:open:border-accent-500">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 rounded-2xl p-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500 [&::-webkit-details-marker]:hidden">
            <span class="flex min-w-0 items-center gap-3">
              <BrandIcon
                slug={p.icon}
                monogram={p.monogram}
                img={p.img}
                emoji={p.emoji}
                brand={p.brand}
                class={p.preserveLogoDetail ? 'brand-detailed' : ''}
                size="size-8"
              />
              <span>
                <span class="block font-bold text-slate-900 dark:text-white">{p.name}</span>
                <span class="block text-sm text-slate-500 dark:text-slate-400">{p.tagline}</span>
              </span>
            </span>
            <span class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-accent-700 dark:text-accent-400" aria-hidden="true">
              <span class="group-open:hidden">Details</span>
              <span class="hidden group-open:inline">Hide</span>
              <svg class="size-4 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </summary>

          <div class="mx-4 border-t border-slate-200 pt-3 pb-4 dark:border-slate-800">
            <ul class="mb-4 space-y-2 text-sm leading-relaxed">
              {p.points.map((pt) => (
                <li class="flex gap-2">
                  <span class="mt-0.5 select-none text-accent-500" aria-hidden="true">
                    ▸
                  </span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>

            <div class="mb-4 flex flex-wrap gap-2">
              {p.tech.map((t) => (
                <span class="brand-hover inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-2.5 py-1 font-mono text-xs text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">
                  {t.icon && <BrandIcon slug={t.icon} size="size-3.5" />}
                  {t.label}
                </span>
              ))}
            </div>

            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-mono text-sm font-semibold text-accent-600 transition-colors hover:text-accent-500 dark:text-accent-400 dark:hover:text-accent-300"
            >
              {p.urlLabel}
              <svg class="size-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7M7 7h10v10" />
              </svg>
            </a>
          </div>
        </details>
      ))
    }
  </div>
</Section>
